# Environment Variables بتتضاف في Vercel (Project > Settings > Environment Variables). مش في الكود.
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# اختياري: مفتاح مشترك للكل. لو سبته فاضي، كل طالب بيحط مفتاحه من تبويب «المفتاح».
GEMINI_API_KEY=
# اختياري: الافتراضي gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
# اختياري: حد الاستخدام لكل مستخدم
ASK_PER_MINUTE=8
ASK_PER_DAY=150
