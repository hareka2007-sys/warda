{
  "functions": { "api/*.py": { "maxDuration": 60, "includeFiles": "api/hue_text.py" } },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.supabase.co; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
    ] },
    { "source": "/sw.js", "headers": [
      { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
      { "key": "Content-Type", "value": "application/javascript; charset=utf-8" } ] },
    { "source": "/manifest.webmanifest", "headers": [
      { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
      { "key": "Cache-Control", "value": "public, max-age=3600" } ] },
    { "source": "/icons/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ]
}
